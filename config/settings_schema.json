[
  {
    "name": "theme_info",
    "theme_name": "Tressa Health",
    "theme_version": "0.1.0",
    "theme_author": "Kevin Scheffler",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#F7F3EC",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#FFFFFF",
        "label": "Surface"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#20201E",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#6F6B64",
        "label": "Muted text"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#B94F3D",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "accent_hover_color",
        "default": "#963D30",
        "label": "Accent hover"
      },
      {
        "type": "color",
        "id": "accent_soft_color",
        "default": "#F2DDD6",
        "label": "Accent background"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#DDD8CF",
        "label": "Borders"
      },
      {
        "type": "header",
        "content": "Corners"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Card corner radius",
        "default": 12
      }
    ]
  }
]